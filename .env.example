# Copy to .env (gitignored) and fill in. Read by docker compose and by Spring
# (spring.config.import in application-local.yml). Run the app from the project root.

# --- HTTP port of the app ---
SERVER_PORT=8080

# --- Local PostgreSQL (docker compose) ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- JWT (required) ---
# Generate with: openssl rand -base64 32
APP_JWT_SECRET=

# --- First admin account (optional; created on startup if it does not exist) ---
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=

# --- Web app that emailed links (verify email, reset password) open ---
APP_FRONTEND_URL=http://localhost:5173

# --- Browser origins allowed to call the API (comma-separated, empty = none) ---
APP_CORS_ALLOWED_ORIGINS=

# --- Stripe card payments (optional; without them the payment endpoints answer 503) ---
# Test-mode secret key from the Stripe Dashboard: Developers > API keys (sk_test_...).
APP_STRIPE_SECRET_KEY=
# Webhook signing secret: `stripe listen --forward-to localhost:8080/api/payments/stripe/webhook` prints one (whsec_...).
APP_STRIPE_WEBHOOK_SECRET=
